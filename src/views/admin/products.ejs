<section class="space-y-3">
  <%
  const badgeMap = {
    hot: { label: "Hot", className: "badge-hot" },
    ready: { label: "Ready", className: "badge-ready" },
    limited: { label: "Limited", className: "badge-limited" },
    new: { label: "New", className: "badge-new" }
  };
  const nowMs = Date.now();
  %>
  <div class="flex items-center justify-between gap-3">
    <h1 class="text-base font-semibold">Produk</h1>
    <a href="/admin/products/new" class="rounded-xl bg-emerald-500 text-black px-3 py-2 text-sm font-semibold hover:bg-emerald-400">Tambah</a>
  </div>

  <% if (errorMessage) { %>
  <p class="text-sm rounded-xl border border-red-500/30 bg-red-500/10 px-3 py-2 text-red-300"><%= errorMessage %></p>
  <% } %>
  <% if (successMessage) { %>
  <p class="text-sm rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 text-emerald-300"><%= successMessage %></p>
  <% } %>

  <% if (!products || products.length === 0) { %>
  <div class="rounded-2xl border border-white/10 bg-slate-900 p-4 text-sm text-slate-300">Belum ada produk.</div>
  <% } else { %>
  <div class="space-y-3">
    <% products.forEach((product) => { %>
    <% const productBadge = badgeMap[String(product.badgeStatus || "").toLowerCase()] || null; %>
    <% const totalViews = Number(product.viewCount || 0); %>
    <% const totalClicks = Number(product.tgClickCount || 0); %>
    <% const productCtr = totalViews > 0 ? ((totalClicks / totalViews) * 100) : 0; %>
    <% const publishMs = product.publishAt ? new Date(product.publishAt).getTime() : 0; %>
    <% const isScheduled = publishMs > nowMs; %>
    <article class="rounded-2xl border border-white/10 bg-slate-900 p-3 flex gap-3">
      <div class="w-20 aspect-[9/16] rounded-lg bg-black/30 overflow-hidden shrink-0">
        <% if (product.images && product.images[0]) { %>
        <img src="<%= product.images[0].imagePath %>" alt="<%= product.title %>" class="h-full w-full object-contain bg-black" />
        <% } %>
      </div>
      <div class="flex-1 space-y-1">
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-semibold"><%= product.title %></h2>
          <% if (productBadge) { %>
          <span class="badge-chip <%= productBadge.className %>"><%= productBadge.label %></span>
          <% } %>
        </div>
        <p class="text-xs text-slate-300"><%= product.category ? product.category.name : 'Tanpa kategori' %></p>
        <p class="text-xs text-slate-300">Views <%= totalViews %> • Klik TG <%= totalClicks %> • CTR <%= productCtr.toFixed(1) %>%</p>
        <p class="text-xs <%= isScheduled ? 'text-cyan-300' : 'text-slate-400' %>">
          <%= isScheduled ? `Terjadwal ${new Date(product.publishAt).toLocaleString("id-ID")}` : 'Publish: langsung / sudah tayang' %>
        </p>
        <p class="text-xs <%= product.isActive ? 'text-emerald-300' : 'text-amber-300' %>">
          <%= product.isActive ? 'Aktif' : 'Nonaktif' %> • <%= product.images ? product.images.length : 0 %> gambar
        </p>

        <div class="flex flex-wrap gap-2 pt-1">
          <a href="/admin/products/<%= product.id %>/edit" class="rounded-lg bg-white/10 px-2 py-1 text-xs">Edit</a>
          <form action="/admin/products/<%= product.id %>/toggle" method="post">
            <button type="submit" class="rounded-lg bg-white/10 px-2 py-1 text-xs">Toggle</button>
          </form>
          <form action="/admin/products/<%= product.id %>/delete" method="post" data-confirm-delete="Hapus produk ini?">
            <button type="submit" class="rounded-lg bg-red-500/20 text-red-200 px-2 py-1 text-xs">Hapus</button>
          </form>
        </div>
      </div>
    </article>
    <% }) %>
  </div>
  <% } %>
</section>
