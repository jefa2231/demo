<!doctype html>
<html lang="id">
  <head>
    <%
    const resolvedMetaDescription = typeof metaDescription === "string" && metaDescription.trim()
      ? metaDescription.trim()
      : `Katalog produk ${appName}`;
    const resolvedMetaUrl = typeof metaUrl === "string" && metaUrl ? metaUrl : "";
    const resolvedOgImageUrl = typeof ogImageUrl === "string" && ogImageUrl ? ogImageUrl : "";
    %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | <%= appName %></title>
    <meta name="description" content="<%= resolvedMetaDescription %>" />
    <meta property="og:title" content="<%= title %> | <%= appName %>" />
    <meta property="og:description" content="<%= resolvedMetaDescription %>" />
    <meta property="og:type" content="website" />
    <% if (resolvedMetaUrl) { %>
    <meta property="og:url" content="<%= resolvedMetaUrl %>" />
    <link rel="canonical" href="<%= resolvedMetaUrl %>" />
    <% } %>
    <% if (resolvedOgImageUrl) { %>
    <meta property="og:image" content="<%= resolvedOgImageUrl %>" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content="<%= resolvedOgImageUrl %>" />
    <% } else { %>
    <meta property="twitter:card" content="summary" />
    <% } %>
    <meta property="twitter:title" content="<%= title %> | <%= appName %>" />
    <meta property="twitter:description" content="<%= resolvedMetaDescription %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Clash+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen">
    <% const isCatalogPage = (currentPath || '').startsWith('/katalog') || (currentPath || '').startsWith('/p/') || (currentPath || '').startsWith('/c/'); %>
    <div class="ambient-wrap pointer-events-none fixed inset-0">
      <span class="ambient-orb ambient-orb-cyan"></span>
      <span class="ambient-orb ambient-orb-emerald"></span>
      <span class="ambient-orb ambient-orb-indigo"></span>
    </div>
    <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(circle_at_15%_5%,rgba(14,165,233,0.12),transparent_35%),radial-gradient(circle_at_85%_20%,rgba(16,185,129,0.10),transparent_40%)]"></div>

    <div class="mx-auto max-w-[480px] px-4 py-4 <%= view === 'public/product-detail' ? 'pb-52' : 'pb-28' %> space-y-4">
      <header class="topbar-shell relative z-10 rounded-2xl border border-white/10 bg-slate-900/70 px-4 py-3 backdrop-blur" data-reveal data-reveal-delay="30">
        <div class="flex items-center justify-between">
          <a href="/" class="inline-flex items-center gap-2 font-title text-lg font-semibold tracking-tight" data-ripple>
            <span class="icon-pill">
              <%- include('../partials/icon', { name: 'store', size: 14 }) %>
            </span>
            <span><%= appName %></span>
          </a>
          <a href="/admin/login" class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-2.5 py-1.5 text-[11px] font-semibold text-slate-200 hover:bg-white/10" data-ripple>
            <%- include('../partials/icon', { name: 'admin', size: 14 }) %>
            <span>Admin</span>
          </a>
        </div>
      </header>

      <main class="relative z-10">
        <%- include('../' + view) %>
      </main>
    </div>

    <nav class="nav-shell fixed bottom-0 left-0 right-0 z-50 border-t border-white/10 bg-slate-950/95 backdrop-blur">
      <div class="mx-auto max-w-[480px] grid h-16 grid-cols-3 px-2">
        <a href="/" class="nav-item <%= currentPath === '/' ? 'nav-item-active' : '' %>" data-ripple>
          <%- include('../partials/icon', { name: 'home', size: 16 }) %>
          <span>Beranda</span>
        </a>
        <a href="/katalog" class="nav-item <%= isCatalogPage ? 'nav-item-active' : '' %>" data-ripple>
          <%- include('../partials/icon', { name: 'grid', size: 16 }) %>
          <span>Katalog</span>
        </a>
        <a href="/admin/login" class="nav-item" data-ripple>
          <%- include('../partials/icon', { name: 'admin', size: 16 }) %>
          <span>Admin</span>
        </a>
      </div>
    </nav>

    <script src="/js/app.js"></script>
  </body>
</html>
