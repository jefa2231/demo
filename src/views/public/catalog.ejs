<section class="space-y-4" data-catalog-page>
  <article class="surface rounded-3xl p-4" data-reveal data-reveal-delay="45">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h1 class="section-title text-base">
          <%- include('../partials/icon', { name: 'grid', size: 16 }) %>
          <span>Katalog Produk</span>
        </h1>
        <p class="mt-1 text-sm text-slate-300">Cari, filter, dan urutkan produk sesuai kebutuhan.</p>
      </div>
      <a href="/katalog" class="inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/5 px-2.5 py-1.5 text-[11px] font-semibold text-slate-200 hover:bg-white/10">
        <%- include('../partials/icon', { name: 'reset', size: 13 }) %>
        <span>Reset</span>
      </a>
    </div>

    <form action="/katalog" method="get" data-live-search-form class="mt-3 space-y-2 rounded-2xl border border-white/10 bg-slate-900/50 p-2.5">
      <div class="flex gap-2">
        <label class="relative flex-1">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
            <%- include('../partials/icon', { name: 'search', size: 14 }) %>
          </span>
          <input
            type="text"
            name="q"
            value="<%= q || '' %>"
            placeholder="Cari produk"
            autocomplete="off"
            data-live-search
            class="w-full rounded-xl border border-white/10 bg-slate-950 py-2 pl-9 pr-3 text-sm text-slate-100 outline-none focus:border-emerald-500/60"
          />
        </label>
        <button type="submit" class="inline-flex items-center gap-1 rounded-xl bg-emerald-500 px-3 py-2 text-sm font-semibold text-black hover:bg-emerald-400" data-ripple>
          <%- include('../partials/icon', { name: 'search', size: 14, strokeWidth: 2 }) %>
          <span>Cari</span>
        </button>
      </div>

      <% if (selectedCategory) { %>
      <input type="hidden" name="category" value="<%= selectedCategory.slug %>" />
      <% } %>
      <input type="hidden" name="sort" value="<%= sort || 'newest' %>" />
    </form>
  </article>

  <div data-catalog-dynamic class="space-y-4">
    <section class="space-y-2" data-reveal data-reveal-delay="75">
      <div class="no-scrollbar flex gap-2 overflow-x-auto pb-1">
        <% sortLinks.forEach((item) => { %>
        <a href="<%= item.url %>" class="chip <%= item.active ? 'chip-active' : '' %>" data-ripple>
          <%- include('../partials/icon', { name: 'sort', size: 12 }) %>
          <span><%= item.label %></span>
        </a>
        <% }) %>
      </div>

      <div class="no-scrollbar flex gap-2 overflow-x-auto pb-1">
        <% categoryLinks.forEach((item) => { %>
        <a href="<%= item.url %>" class="chip <%= item.active ? 'chip-active' : '' %>">
          <%- include('../partials/icon', { name: 'category', size: 12 }) %>
          <span><%= item.name %></span>
          <span class="text-slate-400">(<%= item.total %>)</span>
        </a>
        <% }) %>
      </div>

      <p class="text-xs text-slate-400">
        Menampilkan <span class="font-semibold text-slate-200"><%= products.length %></span> dari
        <span class="font-semibold text-slate-200"><%= pagination.totalProducts %></span> produk.
      </p>
    </section>

    <% if (!products || products.length === 0) { %>
    <div class="rounded-2xl bg-slate-900 border border-white/10 p-4 text-sm text-slate-300">Produk tidak ditemukan.</div>
    <% } else { %>
    <div class="grid grid-cols-2 gap-3" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;">
      <% products.forEach((product, idx) => { %>
      <article class="product-card rounded-2xl overflow-hidden border border-white/10 bg-slate-900/85" data-reveal data-reveal-delay="<%= (idx % 10) * 36 %>">
        <a href="/p/<%= product.slug %>" class="relative block aspect-[9/16] bg-black/20">
          <% if (product.badgeLabel) { %>
          <span class="badge-chip <%= product.badgeClass %> absolute left-2 top-2 z-10"><%= product.badgeLabel %></span>
          <% } %>
          <% if (product.images && product.images[0]) { %>
          <img src="<%= product.images[0].imagePath %>" alt="<%= product.title %>" loading="lazy" class="h-full w-full object-contain bg-black" />
          <% } else { %>
          <div class="h-full w-full flex items-center justify-center text-xs text-slate-400">No Image</div>
          <% } %>
        </a>
        <div class="p-2.5 space-y-1.5">
          <h2 class="text-sm font-semibold leading-snug min-h-[2.4rem] overflow-hidden"><%= product.title %></h2>
          <div class="grid grid-cols-2 gap-1.5">
            <a href="/p/<%= product.slug %>" class="action-btn action-btn-main" data-ripple>
              <%- include('../partials/icon', { name: 'detail', size: 13 }) %>
              <span>Detail</span>
            </a>
            <a href="<%= product.tgTrackUrl || product.tgUrl %>" target="_blank" rel="noopener noreferrer" class="action-btn action-btn-ghost" data-ripple>
              <%- include('../partials/icon', { name: 'telegram', size: 13 }) %>
              <span>TG</span>
            </a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>

    <% if (pagination.totalPages > 1) { %>
    <nav class="mt-4 flex items-center justify-center gap-1.5" data-reveal data-reveal-delay="140">
      <% if (pagination.hasPrev) { %>
      <a href="<%= pagination.prevUrl %>" class="page-btn">
        <%- include('../partials/icon', { name: 'back', size: 13 }) %>
        <span>Prev</span>
      </a>
      <% } %>

      <% pagination.pages.forEach((item) => { %>
      <a href="<%= item.url %>" class="page-btn <%= item.active ? 'page-btn-active' : '' %>"><%= item.page %></a>
      <% }) %>

      <% if (pagination.hasNext) { %>
      <a href="<%= pagination.nextUrl %>" class="page-btn">
        <span>Next</span>
        <%- include('../partials/icon', { name: 'arrow-right', size: 13 }) %>
      </a>
      <% } %>
    </nav>
    <% } %>
    <% } %>
  </div>
</section>
