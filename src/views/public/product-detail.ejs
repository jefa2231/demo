<%
const imageList = Array.isArray(product.images) ? product.images : [];
const imageCount = imageList.length;
const descriptionLines = String(product.description || "")
  .split(/\r?\n/)
  .map((line) => line.trim())
  .filter(Boolean);
const featureList = descriptionLines.length
  ? descriptionLines.slice(0, 5)
  : [
      "Preview langsung dari screenshot produk asli.",
      "Tampilan responsif dan nyaman di mobile.",
      "Foto full frame tanpa terpotong.",
      "Checkout cepat via Telegram."
    ];
const safeTgUrl = (typeof tgUrl !== "undefined" && tgUrl)
  ? tgUrl
  : ((product && (product.tgTrackUrl || product.tgUrl)) || "#");
%>

<section class="space-y-4">
  <article class="surface rounded-3xl p-3.5" data-reveal data-reveal-delay="50">
    <div class="flex items-center justify-between">
      <a href="/katalog" class="inline-flex items-center gap-1.5 rounded-xl border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-200 hover:bg-white/10" data-ripple>
        <%- include('../partials/icon', { name: 'back', size: 13 }) %>
        <span>Katalog</span>
      </a>
      <div class="flex items-center gap-1.5">
        <button type="button" data-share-product data-share-url="<%= shareUrl %>" class="inline-flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-slate-200 hover:bg-white/10" data-ripple>
          <%- include('../partials/icon', { name: 'share', size: 13 }) %>
        </button>
        <button type="button" data-copy-link data-copy-url="<%= shareUrl %>" class="inline-flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-slate-200 hover:bg-white/10" data-ripple>
          <%- include('../partials/icon', { name: 'copy', size: 13 }) %>
        </button>
      </div>
    </div>

    <div class="mt-3 rounded-2xl border border-cyan-300/25 bg-[radial-gradient(circle_at_10%_10%,rgba(34,211,238,0.15),transparent_35%),linear-gradient(145deg,rgba(15,23,42,0.98),rgba(2,6,23,0.92))] p-4">
      <p class="text-[10px] uppercase tracking-[0.2em] text-cyan-200/90">Preview Produk</p>
      <div class="mt-2 flex items-center gap-2">
        <h1 class="text-[1.32rem] font-semibold leading-tight text-slate-100"><%= product.title %></h1>
        <% if (product.badgeLabel) { %>
        <span class="badge-chip <%= product.badgeClass %>"><%= product.badgeLabel %></span>
        <% } %>
      </div>

      <div class="mt-3 grid grid-cols-3 gap-2">
        <div class="rounded-xl border border-white/15 bg-white/5 p-2.5">
          <p class="text-[10px] text-slate-400">Kategori</p>
          <p class="mt-1 text-xs font-semibold text-slate-100"><%= product.category ? product.category.name : 'Umum' %></p>
        </div>
        <div class="rounded-xl border border-white/15 bg-white/5 p-2.5">
          <p class="text-[10px] text-slate-400">Preview</p>
          <p class="mt-1 text-xs font-semibold text-slate-100"><%= imageCount %> gambar</p>
        </div>
        <div class="rounded-xl border border-emerald-300/25 bg-emerald-500/10 p-2.5">
          <p class="text-[10px] text-emerald-200/90">Aksi</p>
          <p class="mt-1 text-xs font-semibold text-emerald-100">Order cepat</p>
        </div>
      </div>

      <ul class="mt-3 space-y-1.5">
        <% featureList.forEach((feature) => { %>
        <li class="flex items-start gap-2 text-sm text-slate-200">
          <span class="mt-[1px] text-cyan-300">
            <%- include('../partials/icon', { name: 'spark', size: 12 }) %>
          </span>
          <span><%= feature %></span>
        </li>
        <% }) %>
      </ul>
    </div>
  </article>

  <article class="surface rounded-3xl p-3.5 space-y-3" data-product-carousel-root data-reveal data-reveal-delay="95">
    <div class="flex items-center justify-between">
      <h2 class="section-title text-sm">
        <%- include('../partials/icon', { name: 'products', size: 14 }) %>
        <span>Galeri Preview</span>
      </h2>
      <span data-carousel-counter class="text-[11px] font-semibold text-slate-300"><%= imageCount > 1 ? `1 / ${imageCount}` : `${imageCount} foto` %></span>
    </div>

    <div class="relative">
      <div class="carousel-viewport overflow-hidden rounded-2xl border border-white/10 bg-black/35" data-product-carousel>
        <div class="carousel-track flex transition-transform duration-300 ease-out" data-carousel-track>
          <% if (imageCount > 0) { %>
            <% imageList.forEach((img, idx) => { %>
            <div class="w-full shrink-0" data-carousel-slide data-index="<%= idx %>">
              <div class="flex min-h-[420px] items-center justify-center bg-slate-950/70 p-2.5 sm:min-h-[500px]">
                <img
                  src="<%= img.imagePath %>"
                  alt="<%= product.title %> - <%= idx + 1 %>"
                  class="max-h-[72vh] w-full cursor-zoom-in object-contain"
                  data-lightbox-open
                  data-index="<%= idx %>"
                />
              </div>
            </div>
            <% }) %>
          <% } else { %>
          <div class="w-full shrink-0" data-carousel-slide data-index="0">
            <div class="flex min-h-[420px] items-center justify-center bg-slate-950/70 text-sm text-slate-400">Belum ada gambar produk.</div>
          </div>
          <% } %>
        </div>
      </div>

      <% if (imageCount > 1) { %>
      <button type="button" data-carousel-prev class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full border border-white/20 bg-slate-950/80 p-2 text-slate-100 backdrop-blur transition hover:bg-slate-900">
        <%- include('../partials/icon', { name: 'back', size: 14 }) %>
      </button>
      <button type="button" data-carousel-next class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full border border-white/20 bg-slate-950/80 p-2 text-slate-100 backdrop-blur transition hover:bg-slate-900">
        <%- include('../partials/icon', { name: 'arrow-right', size: 14 }) %>
      </button>
      <% } %>
    </div>

    <% if (imageCount > 1) { %>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-carousel-thumbs>
      <% imageList.forEach((img, idx) => { %>
      <button
        type="button"
        data-carousel-thumb
        data-lightbox-open
        data-index="<%= idx %>"
        class="carousel-thumb overflow-hidden rounded-xl border border-white/15 bg-slate-900/85 text-left transition hover:border-emerald-300/45"
      >
        <div class="aspect-[9/16] border-b border-white/10 bg-black/35 p-1.5">
          <img src="<%= img.imagePath %>" alt="<%= product.title %> thumb <%= idx + 1 %>" class="h-full w-full object-contain" />
        </div>
        <div class="px-2 py-1.5 text-[11px] font-semibold text-slate-200">Preview <%= idx + 1 %></div>
      </button>
      <% }) %>
    </div>
    <% } %>

    <p class="text-[11px] text-slate-400"><%= imageCount > 1 ? "Pakai tombol kanan/kiri, swipe, atau klik preview di bawah." : "Foto ditampilkan full tanpa crop." %></p>
  </article>

  <article class="surface rounded-3xl p-4" data-reveal data-reveal-delay="130">
    <div class="flex items-center justify-between gap-2">
      <h2 class="section-title text-sm">
        <%- include('../partials/icon', { name: 'detail', size: 14 }) %>
        <span>Deskripsi</span>
      </h2>
      <% if (product.category) { %>
      <a href="/katalog?category=<%= product.category.slug %>" class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-300 hover:text-emerald-200" data-ripple>
        <span>Produk serupa</span>
        <%- include('../partials/icon', { name: 'arrow-right', size: 12 }) %>
      </a>
      <% } %>
    </div>
    <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-300"><%= descriptionLines.length ? descriptionLines.join('\n') : 'Belum ada deskripsi tambahan untuk produk ini.' %></p>
  </article>

  <% if (relatedProducts && relatedProducts.length > 0) { %>
  <section class="space-y-2" data-reveal data-reveal-delay="165">
    <h2 class="section-title text-sm">
      <%- include('../partials/icon', { name: 'spark', size: 14 }) %>
      <span>Produk Serupa Pintar</span>
    </h2>
    <div class="grid grid-cols-2 gap-2">
      <% relatedProducts.forEach((item, idx) => { %>
      <a href="/p/<%= item.slug %>" class="product-card overflow-hidden rounded-xl border border-white/10 bg-slate-900/85" data-reveal data-reveal-delay="<%= (idx % 8) * 45 %>">
        <div class="aspect-[9/16] bg-black/30 p-1.5">
          <% if (item.images && item.images[0]) { %>
          <img src="<%= item.images[0].imagePath %>" alt="<%= item.title %>" class="h-full w-full object-contain" />
          <% } else { %>
          <div class="flex h-full w-full items-center justify-center text-xs text-slate-400">No Image</div>
          <% } %>
        </div>
        <div class="space-y-1.5 p-2">
          <% if (item.badgeLabel) { %>
          <span class="badge-chip <%= item.badgeClass %>"><%= item.badgeLabel %></span>
          <% } %>
          <p class="h-8 overflow-hidden text-[11px] font-semibold leading-snug text-slate-100"><%= item.title %></p>
        </div>
      </a>
      <% }) %>
    </div>
  </section>
  <% } %>
</section>

<div class="lightbox-root" data-product-lightbox aria-hidden="true">
  <button type="button" class="lightbox-backdrop" data-lightbox-close aria-label="Tutup preview fullscreen"></button>
  <div class="lightbox-shell">
    <button type="button" class="lightbox-close-btn" data-lightbox-close>Tutup</button>
    <button type="button" class="lightbox-nav lightbox-nav-left" data-lightbox-prev aria-label="Preview sebelumnya">
      <%- include('../partials/icon', { name: 'back', size: 16 }) %>
    </button>
    <figure class="lightbox-frame">
      <img src="" alt="Preview fullscreen" class="lightbox-image" data-lightbox-image />
      <figcaption class="lightbox-caption" data-lightbox-counter>1 / 1</figcaption>
    </figure>
    <button type="button" class="lightbox-nav lightbox-nav-right" data-lightbox-next aria-label="Preview berikutnya">
      <%- include('../partials/icon', { name: 'arrow-right', size: 16 }) %>
    </button>
  </div>
</div>

<div class="cta-dock fixed bottom-[4.35rem] left-0 right-0 z-[55]">
  <div class="mx-auto max-w-[480px] px-4">
    <a href="<%= safeTgUrl %>" target="_blank" rel="noopener noreferrer" class="group inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-cyan-300/40 bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-300 px-4 py-3 text-sm font-semibold text-slate-950 shadow-card transition hover:brightness-110 active:scale-[0.99]" data-ripple>
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-950/12">
        <%- include('../partials/icon', { name: 'telegram', size: 14, strokeWidth: 2 }) %>
      </span>
      <span>Order Sekarang via Telegram</span>
      <span class="transition group-hover:translate-x-0.5">
        <%- include('../partials/icon', { name: 'arrow-right', size: 14, strokeWidth: 2 }) %>
      </span>
    </a>
  </div>
</div>
